{
  "protocol": "kaggle-adaptation-v1",
  "depth": 56,
  "batch_size": 512,
  "bn_momentum": 0.1,
  "num_workers": 2,
  "seeds": [42, 43, 44],
  "target_val_accuracy": 0.85,
  "experiments": {
    "baseline_long": {
      "schedule": "multistep", "epochs": 120, "lr": 0.1,
      "momentum": 0.9, "weight_decay": 0.0001,
      "milestones": [0.5, 0.75], "gamma": 0.1
    },
    "baseline_short": {
      "schedule": "multistep", "epochs": 24, "lr": 0.1,
      "momentum": 0.9, "weight_decay": 0.0001,
      "milestones": [0.5, 0.75], "gamma": 0.1
    },
    "onecycle": {
      "schedule": "onecycle", "epochs": 24,
      "lr_start": 0.1, "lr_max": 1.0, "lr_final": 0.0001,
      "up_fraction": 0.45, "down_end": 0.9,
      "momentum_max": 0.95, "momentum_min": 0.85, "weight_decay": 0.0001
    },
    "onecycle_low_lr": {
      "schedule": "onecycle", "epochs": 24,
      "lr_start": 0.01, "lr_max": 0.1, "lr_final": 0.00001,
      "up_fraction": 0.45, "down_end": 0.9,
      "momentum_max": 0.95, "momentum_min": 0.85, "weight_decay": 0.0001
    },
    "onecycle_high_wd": {
      "schedule": "onecycle", "epochs": 24,
      "lr_start": 0.1, "lr_max": 1.0, "lr_final": 0.0001,
      "up_fraction": 0.45, "down_end": 0.9,
      "momentum_max": 0.95, "momentum_min": 0.85, "weight_decay": 0.001
    }
  },
  "lr_range": {
    "schedule": "range", "steps": 1000,
    "lr_start": 0.01, "lr_end": 2.0, "weight_decay": 0.0001,
    "validate_every": 50
  }
}

